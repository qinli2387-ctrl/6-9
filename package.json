{
  "name": "ielts-band-six-cloud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --test tests/rendered-html.test.mjs tests/placement-scoring.test.mjs tests/review-lesson.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.local.jsonc",
    "typecheck": "wrangler types worker-configuration.d.ts --config wrangler.local.jsonc && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm db:verify:local && pnpm test",
    "test:app:local": "node scripts/verify-local-app.mjs",
    "preview:auth:local": "node scripts/serve-authenticated-preview.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrations:list:local": "wrangler d1 migrations list band-six-local --config wrangler.local.jsonc --local",
    "db:migrate:local": "wrangler d1 migrations apply band-six-local --config wrangler.local.jsonc --local",
    "db:verify:local": "node scripts/verify-d1-migrations.mjs",
    "db:verify:sqlite": "node scripts/verify-sqlite-migrations.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
